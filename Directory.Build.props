<Project>

  <!-- Build like the Nethermind version in the submodule: same target framework, language version and warnings as errors. -->
  <Import Project="nethermind/Directory.Build.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NethermindSourceDir>$(MSBuildThisFileDirectory)nethermind/src/Nethermind/</NethermindSourceDir>
  </PropertyGroup>

</Project>
